{
  "name": "jspeedz/php-multiprocessor",
  "description": "Forking jobs in PHP to speed up processes",
  "keywords": [
    "forking",
    "multiprocess"
  ],
  "type": "library",
  "minimum-stability": "stable",
  "license": "MIT",
  "authors": [
    {
      "name": "jspeedz",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Jspeedz\\MultiProcessor\\": "src/"
    },
    "files": []
  },
  "autoload-dev": {
    "psr-4": {
      "Jspeedz\\MultiProcessor\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=7.1",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3"
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --configuration=phpstan.neon --memory-limit=256M"
  }
}
