parameters:
    # Supported range, keep in sync with composer.json and the PHPUnit matrix in .github/workflows/ci.yml
    phpVersion:
        min: 80400
        max: 80699
    level: 10
    paths:
        - src
        # Uses Logging\Symfony\Console\LogOutputLockOptionTrait, traits without a user are not analysed
        - tests/Logging/Symfony/Console/LogOutputLockOptionCommand.php
    tmpDir: var/cache/.phpstan.cache
    treatPhpDocTypesAsCertain: false
    editorUrlTitle: '%%relFile%%:%%line%%'